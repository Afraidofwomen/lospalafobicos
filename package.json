{
  "name": "lospalafobicos",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,math,web -c blue,magenta,green \"npm run dev -w @tutor/api\" \"npm run dev:math\" \"npm run dev -w @tutor-ar/web\"",
    "dev:api": "npm run dev -w @tutor/api",
    "dev:math": "services/math/.venv/bin/python -m uvicorn main:app --app-dir services/math --host 127.0.0.1 --port 8000 --reload",
    "dev:web": "npm run dev -w @tutor-ar/web",
    "build": "npm run build -w @tutor-ar/web",
    "preview": "npm run preview -w @tutor-ar/web",
    "test": "npm run test -w @tutor/api && npm run test:math",
    "test:math": "PYTHONPATH=services/math services/math/.venv/bin/python -m pytest services/math/tests -q",
    "typecheck": "npm run typecheck -w @tutor/api && npx -w @tutor-ar/web tsc -b",
    "lint": "npm run lint -w @tutor/api",
    "eval": "tsx eval/run_eval.ts",
    "setup:math": "bash scripts/setup-math.sh"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6"
  }
}
