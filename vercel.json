{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "api": {
      "root": "apps/api",
      "framework": "hono",
      "functions": {
        "src/app.ts": {
          "includeFiles": "public/**"
        }
      },
      "bindings": [
        {
          "type": "service",
          "service": "math",
          "format": "url",
          "env": "MATH_SERVICE_URL"
        }
      ]
    },
    "math": {
      "root": "services/math",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "functions": {
        "main.py": {
          "maxDuration": 300
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
