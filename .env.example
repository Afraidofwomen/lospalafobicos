# API Node
PORT=8787
MATH_SERVICE_URL=http://127.0.0.1:8000
CORS_ORIGIN=*
RATE_LIMIT_PER_MINUTE=30
MAX_IMAGE_BYTES=1500000

# Vercel AI Gateway. En un despliegue de Vercel basta el token OIDC.
# En local hace falta AI_GATEWAY_API_KEY, o LLM_API_KEY si LLM_BASE_URL no es el gateway.
# La clave solo vive en el servidor.
AI_GATEWAY_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://ai-gateway.vercel.sh/v1
LLM_MODEL=google/gemini-3.5-flash-lite
LLM_VISION_MODEL=google/gemini-3.5-flash-lite
